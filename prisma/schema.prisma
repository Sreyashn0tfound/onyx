generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Required for Neon serverless pooling
}

// --- ENUMS ---
enum RoadmapStatus {
  GENERATING
  IN_PROGRESS
  COMPLETED
}

enum NodeStatus {
  LOCKED
  UNLOCKED
  CLEARED
}

enum InterviewType {
  GENERAL_HR
  TECHNICAL_BOSS
}

// --- MODELS ---

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?   // NEW: Required for Auth.js Credentials
  name          String?
  degree        String?
  currentYear   String?
  targetCompany String?
  targetRole    String?
  createdAt     DateTime  @default(now())

  // --- Auth.js Relations ---
  accounts      Account[]
  sessions      Session[]

  // --- Onyx Core Relations ---
  resumeScans       ResumeScan[]
  roadmaps          Roadmap[]
  codeSubmissions   CodeSubmission[]
  interviewSessions InterviewSession[]
}

// --- NEW: AUTH.JS MODELS ---

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- ONYX FEATURE MODELS ---

model ResumeScan {
  id               String   @id @default(uuid())
  userId           String
  overallAtsScore  Int
  roast            String
  missingKeywords  String[]
  improvementPlan  String[]
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Roadmap {
  id             String        @id @default(uuid())
  userId         String
  title          String
  expectedSalary String
  description    String
  requiredSkills String[]
  status         RoadmapStatus @default(IN_PROGRESS)
  createdAt      DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes          RoadmapNode[]
}

model RoadmapNode {
  id                String     @id @default(uuid())
  roadmapId         String
  sequenceIndex     Int        // To keep them in order (1, 2, 3...)
  phaseTitle        String     // e.g., "Phase 01"
  chapterTitle      String     // e.g., "Arrays & Hashing"
  notes             String     // Architect Briefing
  assignmentPrompt  String     // The Trial
  youtubeSearchTerm String
  status            NodeStatus @default(LOCKED)

  roadmap           Roadmap          @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  submissions       CodeSubmission[]
}

model CodeSubmission {
  id          String   @id @default(uuid())
  userId      String
  nodeId      String
  codeWritten String
  aiFeedback  String
  score       Int
  passed      Boolean
  createdAt   DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  node        RoadmapNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model InterviewSession {
  id            String        @id @default(uuid())
  userId        String
  interviewType InterviewType
  transcript    Json          // Stores the exact chat history array
  finalScore    Int?
  summary       String?
  strengths     String[]
  weaknesses    String[]
  createdAt     DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}